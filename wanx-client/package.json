{
  "name": "centuarai-wanx-client",
  "version": "0.1.4",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "shell/entry.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:icons": "xcrun swift tools/generate-icons.swift",
    "build:network": "node tools/build-network.mjs",
    "build:network:all": "node tools/build-network.mjs --all",
    "build:discovery": "node tools/build-discovery.mjs",
    "prestart": "node tools/ensure-network.mjs && node tools/build-discovery.mjs && node tools/build-maintenance.mjs",
    "start": "node tools/start-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "cd native && go test ./...",
    "package:mac": "node tools/build-network.mjs darwin-arm64 darwin-x64 && node tools/build-discovery.mjs darwin-arm64 darwin-x64 && electron-builder --mac --dir",
    "package:windows": "node tools/build-network.mjs win32-x64 win32-arm64 && node tools/build-discovery.mjs win32-x64 && electron-builder --win nsis",
    "build:renderer": "esbuild local-ui/renderer/device-setup-entry.ts --bundle --format=iife --platform=browser --outfile=local-ui/renderer/device-setup.bundle.js",
    "package:application": "node tools/package-application.mjs",
    "patch:provisioning-sdk": "node tools/patch-provisioning-display-name.mjs",
    "package:windows:x64:internal": "node shell/package-win.mjs",
    "build:maintenance": "node tools/build-maintenance.mjs",
    "prepackage:mac": "npm run build:maintenance",
    "prepackage:windows": "npm run build:maintenance"
  },
  "dependencies": {
    "@nexusaos/consumer-contracts": "file:vendor/nexusaos-consumer-contracts-1.0.0.tgz",
    "@nexusaos/device-discovery-contracts": "file:vendor/nexusaos-device-discovery-contracts-1.0.0.tgz",
    "@nexusaos/device-discovery-electron": "file:vendor/nexusaos-device-discovery-electron-1.0.6.tgz",
    "@nexusaos/local-provisioning-contracts": "file:vendor/nexusaos-local-provisioning-contracts-2.0.1-wanx.2.tgz",
    "@nexusaos/local-provisioning-core": "file:vendor/nexusaos-local-provisioning-core-2.0.1-wanx.2.tgz",
    "@nexusaos/local-provisioning-electron-ble": "file:vendor/nexusaos-local-provisioning-electron-ble-2.0.1.tgz",
    "semver": "7.8.5",
    "ws": "8.22.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.9",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "ai.centuarai.wanx.client",
    "productName": "半人马AI-万象",
    "directories": {
      "output": "release"
    },
    "files": [
      "client.mjs",
      "platform.mjs",
      "account/**",
      "shell/**",
      "local-ui/**",
      "network/**",
      "octop/**",
      "app-host/**",
      "applications/**",
      "resources/**",
      "package.json",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "network",
        "filter": [
          "*-LICENSE",
          "go-modules.txt",
          "licenses/**"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/bin",
          "to": "network",
          "filter": [
            "wanx-netbird-darwin-${arch}*",
            "wanx-discovery-darwin-${arch}"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "万象使用蓝牙发现附近的盒子并配置 Wi-Fi。",
        "NSBluetoothPeripheralUsageDescription": "万象使用蓝牙发现附近的盒子并配置 Wi-Fi。"
      }
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/bin",
          "to": "network",
          "filter": [
            "wanx-netbird-win32-${arch}*",
            "wanx-discovery-win32-x64.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "@nexusaos/local-provisioning-contracts": "$@nexusaos/local-provisioning-contracts"
  }
}
