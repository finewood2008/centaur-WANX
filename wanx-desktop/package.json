{
  "name": "centaurai-wanx-desktop",
  "productName": "万象电脑端",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "shell/main.mjs",
  "scripts": {
    "build": "npm --prefix ../dashboard run build:desktop && node tools/license-notices.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "package:mac": "electron-builder --mac --dir",
    "package:windows": "electron-builder --win nsis"
  },
  "dependencies": {
    "centaurai-wanx": "file:../vendor/centaurai-wanx-0.1.0-wanx.1-585a760033fa.tgz",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.centaurai.wanx.desktop",
    "productName": "万象电脑端",
    "directories": {
      "output": "release"
    },
    "files": [
      "shell/**",
      "dist-ui/**",
      "deployment.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/centaurai-wanx/native/bin/**"
    ],
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "万象电脑端在你使用语音输入时访问麦克风。"
      },
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/wanx.icns",
      "extraResources": [
        {
          "from": "../remote-connect/bin/wanx-link-darwin-arm64",
          "to": "remote-connect/bin/wanx-link-darwin-arm64"
        },
        {
          "from": "../remote-connect/manager",
          "to": "remote-connect/manager"
        },
        {
          "from": "../remote-connect/tools/install-mac.py",
          "to": "remote-connect/tools/install-mac.py"
        },
        {
          "from": "../remote-connect/licenses",
          "to": "remote-connect/licenses"
        },
        {
          "from": "../remote-connect/THIRD_PARTY_NOTICES.md",
          "to": "remote-connect/THIRD_PARTY_NOTICES.md"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "WANX_FRAMEWORK_LICENSE"
      },
      {
        "from": "../remote-connect/ui",
        "to": "remote-connect/ui"
      }
    ]
  },
  "description": "万象电脑客户端，连接盒子中的 WANX 服务"
}
