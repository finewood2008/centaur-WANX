{
  "name": "wanxiang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "万象（centaur-WANX）—— 超级个体的应用创造器，以 DSH 为引擎，对话生成可运行的应用",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "wanxiang": "NODE_USE_ENV_PROXY=1 NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 tsx bin/wanxiang.ts",
    "start": "NODE_USE_ENV_PROXY=1 NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 tsx src/server.ts",
    "desktop": "electron electron/main.cjs",
    "icon": "electron scripts/make-icon.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "js-yaml": "^5.4.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@deepseek-ai/dsh-*": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs"
}
