{
  "name": "@centaur/wanxiang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "万象作为 DSH bundle：把产品界面与 API 挂进 DSH 的 web 组合，与「细聊」共享同一个运行时",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
