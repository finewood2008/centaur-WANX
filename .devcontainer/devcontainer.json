{
  "name": "半人马AI-万象",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",

  // 跳过 Electron 的二进制下载：Codespace 里跑的是 Web 服务，桌面外壳用不上。
  "containerEnv": {
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "1",
    "WANXIANG_PORT": "8788",
    "WANXIANG_DSH_PORT": "8891"
  },

  // 装依赖，然后铺一个跑过一次的示例助手。
  // 没有示例的话，没配 key 的访客打开只看得到一张设置表——看不到助手主页、
  // 看不到资料夹、更看不到交付物长什么样。
  "postCreateCommand": "npm install && npm run seed-demo",

  // 附加时自动把服务起起来，端口随即转发。放在对象里 VS Code 会开一个可见的
  // 终端跑它，出错看得见。
  "postAttachCommand": {
    "万象": "npm start"
  },

  // 8788 是万象自己的界面；8891 是它按需拉起的 DSH 子进程，走万象的反向代理，
  // 不需要单独打开。
  "forwardPorts": [8788],
  "portsAttributes": {
    "8788": {
      "label": "万象",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
