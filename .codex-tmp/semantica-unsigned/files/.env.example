# Existing remote Neo4j, through an SSH tunnel; see README.
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_EXISTING_DEV_PASSWORD
NEO4J_DATABASE=neo4j
QDRANT_PATH=data/qdrant

# Skill administration and B4 protected MCP reads (standalone only).
# Enabled by default; no per-feature enable parameter is needed.
# MCP uses the shared standalone read scope, never this administration secret.
# Standalone administration opens directly; no key is required.
# Only legacy managed mode uses X-Skill-Admin-Token (random >=32 chars).
REASONING_SKILL_ADMIN_TOKEN=
# Unbound attachments expire this many hours after upload; bound/published stay.
REASONING_RESOURCE_RETENTION_HOURS=24
# Independent worker also retries orphan-file removal after failures/restarts.
REASONING_RESOURCE_CLEANUP_SECONDS=300
# B1 complete composition content budget; over-limit rules are never truncated.
REASONING_BUNDLE_MAX_CHARS=48000
# B2 preparation receipts expire from creation (reads/retries do not extend TTL).
# Cleanup shares REASONING_RESOURCE_CLEANUP_SECONDS; formal Skills are retained.
REASONING_PREPARATION_RETENTION_DAYS=7

# Explicit chat provider: openai_compatible or ollama. NO automatic fallback.
LLM_PROVIDER=openai_compatible
LLM_PROFILE_PATH=config/llm_profiles.json
MODEL_TIMEOUT_SECONDS=180
# Shared LLM runtime. Saved page settings take precedence over these defaults.
EXTRACTION_STRATEGY=two_stage
LLM_CONCURRENCY=1
KNOWLEDGE_CROSS_PAGE_BATCHES=true
LLM_CONTEXT_TOKENS=4096
LLM_EXTRACTION_INPUT_TOKENS=1024
LLM_EXTRACTION_OUTPUT_TOKENS=768
LLM_SENSITIVE_INPUT_TOKENS=1536
LLM_SENSITIVE_OUTPUT_TOKENS=512
LLM_SENSITIVE_BATCH_SIZE=3
# External API detection budgets are independent of the Ollama small-model budgets.
OPENAI_SENSITIVE_BATCH_SIZE=8
OPENAI_SENSITIVE_INPUT_TOKENS=4096
OPENAI_SENSITIVE_CONTEXT_TOKENS=16384
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=off
OPENAI_STRUCTURED_OUTPUT=text
OPENAI_THINK=off
OPENAI_THINKING_FORMAT=auto
# Explicit off/on uses thinking, enable_thinking or reasoning_effort (none/high).
# auto keeps the provider default; unknown endpoints need an explicit format when off/on is selected.
# text keeps the endpoint's native output limit for existing reasoning models.
# json_object/json_schema use the configured task output token budget.

# External API: provider's base URL, usually https://host/v1.
# Do not append /chat/completions or /responses. HTTPS required outside loopback.
# Exact raw model name; do not add the LiteLLM openai/ prefix.
OPENAI_BASE_URL=REPLACE_WITH_PROVIDER_BASE_URL
OPENAI_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
OPENAI_MODEL=REPLACE_WITH_PROVIDER_CHAT_MODEL

# Existing Ollama: host root only, no /api or /v1. Use a trusted LAN/VPN.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=REPLACE_WITH_INSTALLED_CHAT_MODEL
OLLAMA_EMBED_MODEL=

# Independent embedding provider: none, openai_compatible, ollama or local.
# none allows chat/extraction development without an embedding service.
EMBEDDING_PROVIDER=none
# External embeddings: explicitly fill all three; no chat-key inheritance.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Local embedding mode (implemented in I0). Select with EMBEDDING_PROVIDER=local.
EMBEDDING_LOCAL_PATH=models/embedding/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=8
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# Token-aware work chunks. The local BGE model has a 512-token input limit.
EMBEDDING_CHUNK_TARGET_TOKENS=384
EMBEDDING_CHUNK_MAX_TOKENS=480
EMBEDDING_CHUNK_OVERLAP_TOKENS=64

# Minimum cosine score for vector-only hits. Keyword and graph hits are retained.
# Calibrate for your embedding model and corpus; changing this needs a restart,
# but does not invalidate or rebuild the embedding index.
SEARCH_VECTOR_MIN_SCORE=0.50

# Structure-aware LLM extraction context. Source fragments remain unchanged.
KNOWLEDGE_CHUNK_TARGET_CHARS=1800
KNOWLEDGE_CHUNK_MAX_CHARS=2200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=250

OCR_PROVIDER=rapidocr
OCR_MODEL_DIR=models/ocr/rapidocr
ASR_PROVIDER=faster_whisper
ASR_MODEL_DIR=models/asr/faster-whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_CHUNK_LENGTH_SECONDS=30
ASR_MAX_DURATION_SECONDS=7200
ASR_TIMEOUT_SECONDS=1800
ASR_MIN_AVG_LOGPROB=-1.0
ASR_MAX_NO_SPEECH_PROBABILITY=0.6
MODEL_LOCAL_ONLY=true
MODEL_CPU_THREADS=2
JOB_CONCURRENCY=1
DATA_DIR=data
SQLITE_PATH=data/app.sqlite3
QDRANT_COLLECTION=semantica_chunks_v1
ORIGINALS_DIR=data/originals
DERIVED_DIR=data/derived
PREVIEWS_DIR=data/previews
LOG_DIR=data/logs
BACKUP_DIR=backups
# Required by backup/verify/restore. Keep this secret outside backup archives.
# Use an independently generated value of at least 32 characters.
BACKUP_HMAC_KEY=REPLACE_WITH_RANDOM_64_CHAR_SECRET
STORAGE_MIN_FREE_BYTES=268435456
TEMP_RETENTION_HOURS=24
JOB_HISTORY_RETENTION_DAYS=7
# Automatic retry uses the existing worker, with persistent attempt limits.
JOB_AUTO_RETRY_ENABLED=true
JOB_AUTO_RETRY_DELAYS_SECONDS=[60,300,900]
JOB_AUTO_RETRY_POLL_SECONDS=30
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PDF_PAGES=300
DOCUMENT_MAX_DOCX_EXPANDED_BYTES=268435456
DOCUMENT_MAX_IMAGE_PIXELS=40000000
OCR_RENDER_DPI=144
OCR_MIN_CONFIDENCE=0.55
OCR_PDF_TEXT_MIN_CHARS=12
APP_HOST=127.0.0.1
APP_PORT=8090
# WANX owns authentication in standalone mode. Its private backend sends the
# account/warehouse context; no shared service token or identity sync is needed.
# Keep /api/integration/* reachable only by the trusted WANX backend.
INTEGRATION_MODE=standalone
# Legacy managed deployments still require INTEGRATION_SERVICE_TOKEN,
# INTEGRATION_BOX_ID and INTEGRATION_APPLICATION_ID; standalone ignores them.
# WANX private model relay, in the same host/network namespace.
# Existing explicit overrides are preserved; this is not the public API port.
WANX_MODEL_URL=http://127.0.0.1:18089
# For a LAN deployment set APP_HOST=0.0.0.0 and the browser-facing origin.
# Example: APP_PUBLIC_URL=http://192.168.0.103:8090
APP_PUBLIC_URL=
# Separate new installations when reusing the same external Neo4j database.
# Keep empty for the original local installation; set before first graph publication.
NEO4J_NAMESPACE=
# Personal mode: parse -> extract -> validate -> graph publish -> search index.
KNOWLEDGE_AUTO_PIPELINE=true
# External-Agent MCP. I7 intentionally has no API key or host/origin allowlist.
MCP_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8091
MCP_PATH=/mcp
MCP_REQUEST_TIMEOUT_SECONDS=180
# Legacy MCP elicitation wait; 0 disables the built-in prompt and uses conversation confirmation.
MCP_ELICITATION_TIMEOUT_SECONDS=15
