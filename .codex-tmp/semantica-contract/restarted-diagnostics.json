{
  "local_env_file_only": {
    "integration_service_token": "missing",
    "integration_box_id": "missing",
    "integration_application_id": "missing",
    "integration_application_tokens": "absent_optional",
    "wanx_model_url_explicit": false,
    "wanx_model_url_explicit_port": null
  },
  "running_origin_checks": [
    {
      "path": "/api/integration/status",
      "origin_null_status": 403
    },
    {
      "path": "/api/open/v1/warehouse",
      "origin_null_status": 403
    }
  ],
  "loopback_default_ports": {
    "8090": "reachable",
    "8091": "reachable",
    "8088": {
      "reachable": false,
      "error_type": "TimeoutError"
    },
    "18088": {
      "reachable": false,
      "error_type": "TimeoutError"
    },
    "18089": {
      "reachable": false,
      "error_type": "TimeoutError"
    }
  },
  "bridge_probe_environment_only": {
    "admin_credential_path_in_probe_environment": false
  }
}
