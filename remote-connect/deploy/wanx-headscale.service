[Unit]
Description=WANX private Headscale coordinator
After=network-online.target
Wants=network-online.target
[Service]
User=wanx-headscale
Group=wanx-headscale
WorkingDirectory=/var/lib/wanx-headscale
ExecStart=/usr/local/bin/wanx-headscale --config /etc/wanx-headscale/config.yaml serve
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wanx-headscale
UMask=0077
[Install]
WantedBy=multi-user.target
